<div style="margin:0; padding:28px; background:#eef3f8; font-family:Arial, Helvetica, sans-serif; color:#17202a;">
    <div style="max-width:640px; margin:0 auto;">
        <div style="padding:0 0 12px;">
            <span style="display:inline-block; width:36px; height:36px; border-radius:8px; background:#17202a; color:#ffffff; font-size:14px; font-weight:700; line-height:36px; text-align:center;">ND</span>
        </div>

        <div style="background:#ffffff; border:1px solid #d9e2ec; border-radius:8px; overflow:hidden; box-shadow:0 12px 32px rgba(16, 24, 40, .08);">
            <div style="padding:24px 28px; border-bottom:1px solid #e4e7ec;">
                <div style="font-size:12px; color:#667085; text-transform:uppercase; font-weight:700;">NotifyDB alert</div>
                <h1 style="margin:8px 0 0; font-size:24px; line-height:1.25; color:#101828;">{{ project.name }} changed</h1>
                <p style="margin:8px 0 0; font-size:14px; color:#667085;">{{ event.eventType.value|capitalize }} event on <strong style="color:#344054;">{{ event.tableName }}</strong></p>
            </div>

            <div style="padding:28px;">
                <div style="padding:18px 20px; border:1px solid #d9e2ec; border-radius:8px; background:#f8fafc;">
                    <div style="font-size:12px; color:#667085; text-transform:uppercase; font-weight:700; margin-bottom:8px;">Summary</div>
                    <p style="margin:0; font-size:16px; line-height:1.65; color:#17202a;">{{ summary|nl2br }}</p>
                </div>

                <table style="width:100%; border-collapse:collapse; font-size:14px; margin-top:22px;">
                    <tr>
                        <th style="text-align:left; padding:12px 0; border-top:1px solid #e4e7ec; color:#667085; font-weight:700;">Table</th>
                        <td style="text-align:right; padding:12px 0; border-top:1px solid #e4e7ec; color:#17202a;">{{ event.tableName }}</td>
                    </tr>
                    <tr>
                        <th style="text-align:left; padding:12px 0; border-top:1px solid #e4e7ec; color:#667085; font-weight:700;">Record</th>
                        <td style="text-align:right; padding:12px 0; border-top:1px solid #e4e7ec; color:#17202a;">{{ event.recordId }}</td>
                    </tr>
                    <tr>
                        <th style="text-align:left; padding:12px 0; border-top:1px solid #e4e7ec; color:#667085; font-weight:700;">Event</th>
                        <td style="text-align:right; padding:12px 0; border-top:1px solid #e4e7ec; color:#17202a;">{{ event.eventType.value }}</td>
                    </tr>
                </table>

                <div style="padding-top:22px;">
                    <a href="{{ dashboardUrl }}" style="display:inline-block; padding:11px 16px; background:#17202a; color:#ffffff; text-decoration:none; border-radius:6px; font-size:14px; font-weight:700;">Open dashboard</a>
                </div>
            </div>
        </div>

        <div style="padding:16px 4px 0; font-size:12px; line-height:1.5; color:#667085;">
            You are receiving this because {{ project.name }} has NotifyDB notifications enabled.
        </div>
    </div>
</div>
