<div style="margin:0; padding:28px; background:#eef3f8; font-family:Arial, Helvetica, sans-serif; color:#17202a;">
    <div style="max-width:720px; margin:0 auto;">
        <div style="padding:0 0 12px;">
            <span style="display:inline-block; width:36px; height:36px; border-radius:8px; background:#17202a; color:#ffffff; font-size:14px; font-weight:700; line-height:36px; text-align:center;">ND</span>
        </div>

        <div style="background:#ffffff; border:1px solid #d9e2ec; border-radius:8px; overflow:hidden; box-shadow:0 12px 32px rgba(16, 24, 40, .08);">
            <div style="padding:24px 28px; border-bottom:1px solid #e4e7ec;">
                <div style="font-size:12px; color:#667085; text-transform:uppercase; font-weight:700;">NotifyDB digest</div>
                <h1 style="margin:8px 0 0; font-size:24px; line-height:1.25; color:#101828;">{{ digestLabel|default('Daily') }} digest for {{ project.name }}</h1>
                <p style="margin:8px 0 0; font-size:14px; color:#667085;">{{ events|length }} pending {{ events|length == 1 ? 'change' : 'changes' }} summarized for review.</p>
            </div>

            <div style="padding:10px 28px 28px;">
                {% for event in events %}
                    <article style="padding:20px 0; border-bottom:1px solid #e4e7ec;">
                        <div style="font-size:12px; color:#667085; text-transform:uppercase; font-weight:700; margin-bottom:6px;">{{ event.tableName }} #{{ event.recordId }}</div>
                        <h2 style="margin:0 0 10px; font-size:17px; line-height:1.35; color:#101828;">
                            {{ event.eventType.value|capitalize }} event
                        </h2>
                        <p style="margin:0; font-size:15px; line-height:1.65; color:#344054;">{{ formatter.format(event)|nl2br }}</p>
                    </article>
                {% endfor %}

                <div style="padding-top:22px;">
                    <a href="{{ dashboardUrl }}" style="display:inline-block; padding:11px 16px; background:#17202a; color:#ffffff; text-decoration:none; border-radius:6px; font-size:14px; font-weight:700;">Open dashboard</a>
                </div>
            </div>
        </div>

        <div style="padding:16px 4px 0; font-size:12px; line-height:1.5; color:#667085;">
            You are receiving this because {{ project.name }} has {{ digestLabel|default('daily')|lower }} NotifyDB digests enabled.
        </div>
    </div>
</div>
